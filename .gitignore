# Share project code and reviewed documentation. Keep local data out by default.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/Scripts/
!/Notebooks/
!/Docs/

/Scripts/*
!/Scripts/*.py
/Notebooks/*
!/Notebooks/*.ipynb
/Docs/*
!/Docs/*.md
!/Docs/exchange_rates.csv

# Keep course inputs and generated evidence outside the public tree.
/LocalData/
/Audit/
/Working/
/marketplace_raw.csv
/marketplace_cleaned.csv
/.venv/

__pycache__/
.ipynb_checkpoints/
