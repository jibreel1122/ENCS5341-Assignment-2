# Share project code and reviewed documentation. Keep local data out by default.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/Scripts/
!/Notebooks/
!/Docs/

/Scripts/*
!/Scripts/*.py
/Notebooks/*
!/Notebooks/*.ipynb
/Docs/*
!/Docs/*.md
!/Docs/exchange_rates.csv
!/Docs/*.pdf

# Keep course inputs and generated evidence outside the public tree.
/LocalData/
/Audit/
/Working/
/marketplace_raw.csv
/marketplace_cleaned.csv
/.venv/
!/Data/
!/Data/*.csv
!/Audit/
!/Audit/*.md
!/Audit/*.csv
!/Audit/*.png
!/Audit/public/
/Audit/public/*
!/Audit/public/*.md
!/Audit/public/*.csv

__pycache__/
.ipynb_checkpoints/
